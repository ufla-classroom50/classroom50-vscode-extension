{
  "name": "classroom50-vscode-extension",
  "displayName": "classroom50-vscode-extension",
  "description": "Notifies students about new feedback comments in Classroom 50 assignments",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "classroom50-vscode-extension.checkFeedback",
        "title": "Check for new feedback",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.openFeedbackPR",
        "title": "Open feedback PR in browser",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.openSupportLinks",
        "title": "Open support materials",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.listStudents",
        "title": "List students",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.sendAnnouncement",
        "title": "Send announcement to students",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.submitAssignment",
        "title": "Submit assignment",
        "category": "Classroom 50"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
