{
  "name": "classroom50-vscode-extension",
  "displayName": "Classroom 50",
  "description": "%extension.description%",
  "author": {
    "name": "João Pedro Alves Carneiro Valadão",
    "url": "https://github.com/crnvsk"
  },
  "version": "0.2.0",
  "publisher": "ufla-classroom50",
  "repository": {
    "type": "git",
    "url": "https://github.com/ufla-classroom50/classroom50-vscode-extension"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, only the teacher sidebar is available. Trust the folder to enable feedback notifications, submission and the Feedback PR button."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "classroom50-vscode-extension.checkFeedback",
        "title": "%command.checkFeedback%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.openFeedback",
        "title": "%command.openFeedback%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.openFeedbackPR",
        "title": "%command.openFeedbackPR%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.openSupportLinks",
        "title": "%command.openSupportLinks%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.submitAssignment",
        "title": "%command.submitAssignment%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.selectOrganization",
        "title": "%command.selectOrganization%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.selectAssignment",
        "title": "%command.selectAssignment%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.loadStudents",
        "title": "%command.loadStudents%",
        "category": "Classroom 50",
        "icon": "$(refresh)"
      },
      {
        "command": "classroom50-vscode-extension.toggleAllStudents",
        "title": "%command.toggleAllStudents%",
        "category": "Classroom 50",
        "icon": "$(check-all)"
      },
      {
        "command": "classroom50-vscode-extension.sendAnnouncement",
        "title": "%command.sendAnnouncement%",
        "category": "Classroom 50",
        "icon": "$(megaphone)"
      },
      {
        "command": "classroom50-vscode-extension.openStudentRepo",
        "title": "%command.openStudentRepo%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.signIn",
        "title": "%command.signIn%",
        "category": "Classroom 50"
      },
      {
        "command": "classroom50-vscode-extension.refreshAssignments",
        "title": "%command.refreshAssignments%",
        "category": "Classroom 50",
        "icon": "$(refresh)"
      },
      {
        "command": "classroom50-vscode-extension.acceptAssignment",
        "title": "%command.acceptAssignment%",
        "category": "Classroom 50",
        "icon": "$(check)"
      },
      {
        "command": "classroom50-vscode-extension.cloneAssignment",
        "title": "%command.cloneAssignment%",
        "category": "Classroom 50",
        "icon": "$(cloud-download)"
      },
      {
        "command": "classroom50-vscode-extension.openAssignment",
        "title": "%command.openAssignment%",
        "category": "Classroom 50",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "classroom50",
          "title": "Classroom 50",
          "icon": "resources/classroom50.svg"
        }
      ]
    },
    "views": {
      "classroom50": [
        {
          "id": "classroom50.studentView",
          "name": "%view.assignments%",
          "when": "!classroom50.signedIn || classroom50.isStudent || !classroom50.isTeacher",
          "icon": "resources/classroom50.svg"
        },
        {
          "id": "classroom50.teacherView",
          "name": "%view.teacher%",
          "when": "classroom50.isTeacher",
          "icon": "resources/classroom50.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "classroom50-vscode-extension.loadStudents",
          "when": "view == classroom50.teacherView",
          "group": "navigation@1"
        },
        {
          "command": "classroom50-vscode-extension.toggleAllStudents",
          "when": "view == classroom50.teacherView",
          "group": "navigation@2"
        },
        {
          "command": "classroom50-vscode-extension.sendAnnouncement",
          "when": "view == classroom50.teacherView",
          "group": "navigation@3"
        },
        {
          "command": "classroom50-vscode-extension.refreshAssignments",
          "when": "view == classroom50.studentView && classroom50.signedIn",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "classroom50-vscode-extension.checkFeedback",
          "when": "classroom50.isStudentRepo"
        },
        {
          "command": "classroom50-vscode-extension.openFeedback",
          "when": "classroom50.isStudentRepo"
        },
        {
          "command": "classroom50-vscode-extension.openSupportLinks",
          "when": "classroom50.isStudentRepo"
        },
        {
          "command": "classroom50-vscode-extension.submitAssignment",
          "when": "classroom50.isStudentRepo"
        },
        {
          "command": "classroom50-vscode-extension.openFeedbackPR",
          "when": "classroom50.hasFeedbackPR"
        },
        {
          "command": "classroom50-vscode-extension.selectOrganization",
          "when": "classroom50.isTeacher"
        },
        {
          "command": "classroom50-vscode-extension.selectAssignment",
          "when": "classroom50.isTeacher"
        },
        {
          "command": "classroom50-vscode-extension.loadStudents",
          "when": "classroom50.isTeacher"
        },
        {
          "command": "classroom50-vscode-extension.toggleAllStudents",
          "when": "classroom50.isTeacher"
        },
        {
          "command": "classroom50-vscode-extension.sendAnnouncement",
          "when": "classroom50.isTeacher"
        },
        {
          "command": "classroom50-vscode-extension.openStudentRepo",
          "when": "false"
        },
        {
          "command": "classroom50-vscode-extension.acceptAssignment",
          "when": "false"
        },
        {
          "command": "classroom50-vscode-extension.cloneAssignment",
          "when": "false"
        },
        {
          "command": "classroom50-vscode-extension.openAssignment",
          "when": "false"
        },
        {
          "command": "classroom50-vscode-extension.refreshAssignments",
          "when": "classroom50.signedIn"
        }
      ],
      "view/item/context": [
        {
          "command": "classroom50-vscode-extension.acceptAssignment",
          "when": "view == classroom50.studentView && viewItem == assignment.notAccepted",
          "group": "inline"
        },
        {
          "command": "classroom50-vscode-extension.cloneAssignment",
          "when": "view == classroom50.studentView && viewItem == assignment.accepted",
          "group": "inline"
        },
        {
          "command": "classroom50-vscode-extension.openAssignment",
          "when": "view == classroom50.studentView && viewItem == assignment.cloned",
          "group": "inline"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "classroom50"
      }
    ],
    "viewsWelcome": [
      {
        "view": "classroom50.studentView",
        "contents": "%view.assignments.signIn%",
        "when": "!classroom50.signedIn"
      }
    ],
    "configuration": {
      "title": "Classroom 50",
      "properties": {
        "classroom50.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-br"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ptbr%"
          ],
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "js-yaml": "^4.3.2",
    "serialize-javascript": "^7.1.3"
  }
}
